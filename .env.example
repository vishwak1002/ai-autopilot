# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: openrouter (default) | anthropic | openai
AI_PROVIDER=openrouter

# Your OpenRouter API key — get one at https://openrouter.ai/keys
AI_API_KEY=sk-or-v1-your-key-here

# Model to use via OpenRouter — pick any from https://openrouter.ai/models
# Examples:
#   anthropic/claude-opus-4-5
#   anthropic/claude-sonnet-4-5-20250514
#   openai/gpt-4o
#   google/gemini-2.0-flash
#   meta-llama/llama-3.3-70b-instruct
AI_MODEL=anthropic/claude-sonnet-4-5-20250514

# Optional: shown in OpenRouter dashboard under your usage
OPENROUTER_SITE_URL=https://github.com/vishwak1002/ai-autopilot
OPENROUTER_APP_NAME=ai-autopilot

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Personal Access Token with repo + workflow scopes
GH_PAT=your_github_pat_here

# ── Merge threshold ────────────────────────────────────────────────────────────
MERGE_THRESHOLD=8
