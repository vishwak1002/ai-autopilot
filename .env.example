# AI Provider — swap to change provider (anthropic | openai)
AI_PROVIDER=anthropic

# Your AI API key
AI_API_KEY=your_api_key_here

# Model to use (placeholder — set your preferred model)
AI_MODEL=claude-opus-4-5

# GitHub Personal Access Token (repo + workflow scopes)
GH_PAT=your_github_pat_here

# Merge threshold (default: 8)
MERGE_THRESHOLD=8
